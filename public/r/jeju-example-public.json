{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "jeju-example-public",
  "type": "registry:block",
  "title": "예제: 대민 서비스 화면",
  "description": "제주 돌봄서비스. Tier 1 public.html의 React판.",
  "registryDependencies": [
    "@jeju/accordion",
    "@jeju/alert",
    "@jeju/breadcrumb",
    "@jeju/button",
    "@jeju/checkbox",
    "@jeju/field",
    "@jeju/input",
    "@jeju/jeju-common",
    "@jeju/jeju-contact",
    "@jeju/jeju-doc-list",
    "@jeju/jeju-eligibility-check",
    "@jeju/jeju-file-upload",
    "@jeju/jeju-icons",
    "@jeju/jeju-public-shell",
    "@jeju/jeju-related-links",
    "@jeju/jeju-service-search",
    "@jeju/jeju-tokens",
    "@jeju/jeju-wizard",
    "@jeju/label"
  ],
  "files": [
    {
      "path": "registry/jeju/examples/jeju-example-public.tsx",
      "type": "registry:component",
      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from \"@/components/ui/accordion\"\nimport { Alert, AlertDescription, AlertTitle } from \"@/components/ui/alert\"\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/components/ui/breadcrumb\"\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport { Field, FieldDescription, FieldLabel } from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport {\n  BuildingIcon,\n  ClockIcon,\n  ExternalLinkIcon,\n  InfoIcon,\n  LocationIcon,\n  PhoneIcon,\n} from \"@/components/ui/jeju-icons\"\nimport { SkipLink } from \"@/components/jeju-common\"\nimport { ContactCard } from \"@/components/jeju-contact\"\nimport { DocList } from \"@/components/jeju-doc-list\"\nimport { EligibilityCheck } from \"@/components/jeju-eligibility-check\"\nimport { FileUpload } from \"@/components/jeju-file-upload\"\nimport {\n  Hero,\n  Identifier,\n  Masthead,\n  PublicCard,\n  PublicFooter,\n  PublicHeader,\n  PublicMain,\n  PublicPageTitle,\n} from \"@/components/jeju-public-shell\"\nimport { RelatedLinks } from \"@/components/jeju-related-links\"\nimport { ServiceSearch, type ServiceItem } from \"@/components/jeju-service-search\"\nimport { Wizard } from \"@/components/jeju-wizard\"\n\n// 대민 화면 기준 예제: 제주 돌봄서비스(Tier 1 design/examples/public.html의 React판).\n// 실제 서비스는 index.html의 <html data-jeju-profile=\"public\">로 프로필을 고정한다.\n// 이 예제는 여러 예제를 한 앱에서 오가도록 마운트될 때 속성을 붙이고 떠날 때 되돌린다.\nfunction usePublicProfile() {\n  React.useEffect(() => {\n    const root = document.documentElement\n    const previous = root.getAttribute(\"data-jeju-profile\")\n    root.setAttribute(\"data-jeju-profile\", \"public\")\n    return () => {\n      if (previous === null) root.removeAttribute(\"data-jeju-profile\")\n      else root.setAttribute(\"data-jeju-profile\", previous)\n    }\n  }, [])\n}\n\nconst services: ServiceItem[] = [\n  { id: \"meal\", title: \"식사 지원\", category: \"생활지원\", badge: \"success\", description: \"식사 준비가 어려운 분에게 도시락이나 식재료를 연계합니다.\", meta: \"대상: 혼자 식사 준비가 어려운 도민 · 신청: 온라인·방문\", href: \"#apply\", keywords: \"도시락 반찬 끼니 밥\" },\n  { id: \"house\", title: \"가사 지원\", category: \"생활지원\", badge: \"success\", description: \"청소·세탁 같은 집안일을 도와드립니다.\", meta: \"대상: 거동이 불편한 도민 · 신청: 방문\", href: \"#apply\", keywords: \"청소 빨래 세탁 집안일\" },\n  { id: \"check\", title: \"안부 확인\", category: \"안전·건강\", badge: \"info\", description: \"정기적인 전화와 방문으로 생활 상태를 확인합니다.\", meta: \"대상: 혼자 사는 도민 · 신청: 온라인·전화\", href: \"#apply\", keywords: \"전화 방문 고독\" },\n  { id: \"hospital\", title: \"병원 동행\", category: \"안전·건강\", badge: \"info\", description: \"병원 진료와 검사에 동행하고 귀가를 돕습니다.\", meta: \"대상: 혼자 병원에 가기 어려운 도민 · 신청: 전화\", href: \"#apply\", keywords: \"병원 진료 동행 이동\" },\n  { id: \"repair\", title: \"주거환경 개선\", category: \"주거\", badge: \"warning\", description: \"문턱 제거, 안전 손잡이 설치 등 집 안 위험 요소를 고칩니다.\", meta: \"대상: 65세 이상 또는 장애가 있는 도민 · 신청: 방문\", href: \"#apply\", keywords: \"집수리 손잡이 문턱 안전\" },\n  { id: \"shelter\", title: \"임시 거처 지원\", category: \"주거\", badge: \"warning\", description: \"퇴원 뒤 머물 곳이 필요한 분에게 임시 거처를 연계합니다.\", meta: \"대상: 퇴원 예정 도민 · 신청: 병원·주민센터\", href: \"#apply\", keywords: \"퇴원 거처 숙소\" },\n]\n\nexport default function JejuExamplePublic() {\n  usePublicProfile()\n\n  return (\n    <div className=\"min-h-svh bg-card\">\n      <SkipLink />\n      <Masthead>제주특별자치도 공공서비스 UI 예제</Masthead>\n      <PublicHeader\n        brand={{ name: \"제주 돌봄서비스\", href: \"#/public\" }}\n        nav={[\n          { label: \"서비스 찾기\", href: \"#service-list\", current: true },\n          { label: \"신청 안내\", href: \"#guide\" },\n          { label: \"자격 확인\", href: \"#eligibility\" },\n          { label: \"신청 절차\", href: \"#apply\" },\n          { label: \"자주 묻는 질문\", href: \"#faq\" },\n        ]}\n      />\n      <PublicMain>\n        <Breadcrumb className=\"mb-5\">\n          <BreadcrumbList>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#/public\">홈</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator />\n            <BreadcrumbItem>\n              <BreadcrumbPage>돌봄서비스</BreadcrumbPage>\n            </BreadcrumbItem>\n          </BreadcrumbList>\n        </Breadcrumb>\n\n        <Hero\n          eyebrow=\"필요한 돌봄을 한곳에서\"\n          title=\"나에게 맞는 돌봄서비스를 찾아보세요\"\n          description=\"생활에 도움이 필요한 제주도민이 이용 가능한 돌봄서비스를 이해하기 쉬운 기준으로 안내합니다.\"\n          actions={\n            <>\n              <Button size=\"lg\" asChild>\n                <a href=\"#service-list\">서비스 찾기</a>\n              </Button>\n              <Button size=\"lg\" variant=\"outline\" asChild>\n                <a href=\"#guide\">신청 방법 보기</a>\n              </Button>\n            </>\n          }\n        />\n\n        <section id=\"service-list\" aria-labelledby=\"service-title\" className=\"mt-14 scroll-mt-4\">\n          <PublicPageTitle\n            id=\"service-title\"\n            title=\"돌봄서비스 찾기\"\n            description=\"필요한 도움을 검색하거나 분류를 골라 보세요. 서비스 이름만 보아도 목적을 알 수 있도록 짧고 구체적으로 씁니다.\"\n          />\n          <ServiceSearch services={services} categories={[\"생활지원\", \"안전·건강\", \"주거\"]} searchLabel=\"돌봄서비스 검색\" />\n        </section>\n\n        <section id=\"eligibility\" aria-labelledby=\"eligibility-title\" className=\"mt-14 scroll-mt-4\">\n          <PublicPageTitle\n            id=\"eligibility-title\"\n            title=\"신청 자격 확인\"\n            description=\"세 가지 질문에 답하면 신청할 수 있는지 바로 알려 드립니다. 자가 확인 결과이며 최종 결과는 심사 후 안내합니다.\"\n          />\n          <EligibilityCheck\n            questions={[\n              { id: \"check-resident\", label: \"주민등록\", question: \"제주특별자치도에 주민등록이 되어 있나요?\" },\n              { id: \"check-need\", label: \"돌봄 필요\", question: \"혼자 식사 준비나 외출이 어려운가요?\", hint: \"일시적으로 어려운 경우도 포함합니다.\" },\n              { id: \"check-other\", label: \"다른 돌봄 제도\", question: \"장기요양 등급을 받아 같은 서비스를 이미 이용하고 있나요?\", hint: \"이용 중이면 중복 지원이 제한될 수 있습니다.\", qualify: \"no\" },\n            ]}\n          />\n        </section>\n\n        <section id=\"apply\" aria-labelledby=\"apply-title\" className=\"mt-14 scroll-mt-4\">\n          <PublicPageTitle\n            id=\"apply-title\"\n            title=\"신청 절차\"\n            description=\"네 단계로 신청할 수 있습니다. 각 단계에서 필요한 준비물을 미리 확인하세요.\"\n          />\n          <Wizard\n            progressLabel=\"신청 절차 진행률\"\n            steps={[\n              {\n                label: \"자격 확인\",\n                content: (\n                  <div className=\"grid gap-3\">\n                    <h3 className=\"m-0 text-(length:--jeju-text-lg)\">1단계 · 자격을 확인하세요</h3>\n                    <p className=\"m-0\">아래 항목 중 하나 이상에 해당하면 신청할 수 있습니다.</p>\n                    {[\"제주특별자치도에 주민등록이 되어 있습니다.\", \"혼자 식사 준비나 외출이 어렵습니다.\", \"가까이에서 돌볼 가족이 없습니다.\"].map(\n                      (text, index) => (\n                        <Field key={text} orientation=\"horizontal\">\n                          <Checkbox id={\"eligible-\" + index} />\n                          <FieldLabel htmlFor={\"eligible-\" + index} className=\"font-semibold\">\n                            {text}\n                          </FieldLabel>\n                        </Field>\n                      )\n                    )}\n                  </div>\n                ),\n              },\n              {\n                label: \"서류 준비\",\n                content: (\n                  <div className=\"grid gap-3\">\n                    <h3 className=\"m-0 text-(length:--jeju-text-lg)\">2단계 · 서류를 준비하세요</h3>\n                    <p className=\"m-0\">신분증과 함께 아래 서류 중 해당하는 것을 준비합니다.</p>\n                    <ul className=\"m-0 pl-6\">\n                      <li>건강 상태를 확인할 수 있는 진단서 또는 소견서</li>\n                      <li>가족 관계를 확인할 수 있는 서류</li>\n                    </ul>\n                    <FileUpload\n                      dropText=\"준비한 서류를 미리 올려둘 수 있습니다.\"\n                      hint=\"PDF · JPG · 파일당 10MB 이하\"\n                      maxSizeMB={10}\n                      listLabel=\"올린 서류\"\n                      emptyText=\"아직 올린 서류가 없습니다.\"\n                    />\n                  </div>\n                ),\n              },\n              {\n                label: \"신청서 제출\",\n                content: (\n                  <div className=\"grid gap-3\">\n                    <h3 className=\"m-0 text-(length:--jeju-text-lg)\">3단계 · 신청서를 제출하세요</h3>\n                    <p className=\"m-0\">온라인 제출이 어렵다면 읍·면·동 주민센터를 방문해 도움을 받을 수 있습니다.</p>\n                    <Field className=\"max-w-md\">\n                      <Label htmlFor=\"public-phone\" required>\n                        연락받을 전화번호\n                      </Label>\n                      <Input id=\"public-phone\" type=\"tel\" inputMode=\"tel\" placeholder=\"064-710-0000\" aria-describedby=\"public-phone-hint\" />\n                      <FieldDescription id=\"public-phone-hint\">신청 결과를 문자로 안내해 드립니다.</FieldDescription>\n                    </Field>\n                  </div>\n                ),\n              },\n              {\n                label: \"결과 확인\",\n                content: (\n                  <div className=\"grid gap-3\">\n                    <h3 className=\"m-0 text-(length:--jeju-text-lg)\">4단계 · 결과를 확인하세요</h3>\n                    <p className=\"m-0\">신청 후 약 14일 이내에 문자와 우편으로 결과를 안내합니다.</p>\n                    <Alert variant=\"info\" role=\"note\">\n                      <InfoIcon />\n                      <AlertTitle>안내</AlertTitle>\n                      <AlertDescription>결과가 오지 않으면 담당 주민센터로 문의해 주세요.</AlertDescription>\n                    </Alert>\n                  </div>\n                ),\n              },\n            ]}\n          />\n        </section>\n\n        <section id=\"guide\" aria-labelledby=\"guide-title\" className=\"mt-14 grid scroll-mt-4 grid-cols-2 gap-4 max-[900px]:grid-cols-1\">\n          <PublicCard>\n            <h2 id=\"guide-title\" className=\"text-(length:--jeju-text-xl)\">\n              신청 전 확인하세요\n            </h2>\n            <p>서비스마다 대상과 지원 범위가 다를 수 있습니다. 신청 전에 기본 자격과 필요한 서류를 확인하세요.</p>\n            <Alert variant=\"info\" role=\"note\">\n              <InfoIcon />\n              <AlertTitle>안내</AlertTitle>\n              <AlertDescription>복잡한 조건은 한 문장에 몰아넣지 않고 단계별로 나누어 안내합니다.</AlertDescription>\n            </Alert>\n          </PublicCard>\n          <PublicCard>\n            <h2 className=\"text-(length:--jeju-text-xl)\">도움이 필요하신가요?</h2>\n            <p>온라인 신청이 어렵다면 가까운 읍·면·동 주민센터 또는 담당기관에서 안내받을 수 있습니다.</p>\n            <div>\n              <Button size=\"lg\" asChild>\n                <a href=\"tel:064-710-0000\">\n                  <PhoneIcon />\n                  전화 문의 064-710-0000\n                </a>\n              </Button>\n            </div>\n          </PublicCard>\n        </section>\n\n        <section id=\"faq\" aria-labelledby=\"faq-title\" className=\"mt-14 scroll-mt-4\">\n          <PublicPageTitle id=\"faq-title\" title=\"자주 묻는 질문\" description=\"질문 제목을 선택하면 답변이 열립니다.\" />\n          <Accordion type=\"single\" collapsible defaultValue=\"faq-1\">\n            <AccordionItem value=\"faq-1\">\n              <AccordionTrigger>가족과 함께 살아도 신청할 수 있나요?</AccordionTrigger>\n              <AccordionContent>\n                <p>신청할 수 있습니다. 함께 사는 가족이 돌보기 어려운 상황이라면 상담을 통해 필요한 서비스를 연계합니다.</p>\n              </AccordionContent>\n            </AccordionItem>\n            <AccordionItem value=\"faq-2\">\n              <AccordionTrigger>신청하면 비용이 드나요?</AccordionTrigger>\n              <AccordionContent>\n                <p>서비스 종류와 소득 기준에 따라 본인부담금이 있을 수 있습니다. 상담 단계에서 예상 비용을 먼저 안내해 드립니다.</p>\n              </AccordionContent>\n            </AccordionItem>\n            <AccordionItem value=\"faq-3\">\n              <AccordionTrigger>결과는 얼마나 걸리나요?</AccordionTrigger>\n              <AccordionContent>\n                <p>신청일로부터 약 14일 이내에 문자와 우편으로 결과를 안내합니다. 자료 보완이 필요하면 담당자가 먼저 연락드립니다.</p>\n              </AccordionContent>\n            </AccordionItem>\n          </Accordion>\n        </section>\n\n        <section id=\"documents\" aria-labelledby=\"documents-title\" className=\"mt-14 grid scroll-mt-4 gap-8\">\n          <div className=\"grid grid-cols-2 items-start gap-4 max-[900px]:grid-cols-1\">\n            <div className=\"grid min-w-0 gap-3\">\n              <h2 id=\"documents-title\" className=\"m-0 text-(length:--jeju-text-xl) font-bold text-(--jeju-text-strong)\">\n                서식 내려받기\n              </h2>\n              <DocList\n                docs={[\n                  { title: \"돌봄서비스 신청서\", format: \"HWPX\", size: \"38KB\", updated: \"2026-09-01 개정\", href: \"#\" },\n                  { title: \"개인정보 수집·이용 동의서\", format: \"PDF\", size: \"112KB\", updated: \"2026-03-02 개정\", href: \"#\" },\n                  { title: \"서비스 안내 책자\", format: \"PDF\", size: \"2.4MB\", updated: \"2026-01-15 발행\", href: \"#\" },\n                ]}\n              />\n            </div>\n            <ContactCard\n              rows={[\n                { label: \"담당 부서\", icon: <BuildingIcon />, value: \"제주특별자치도 통합돌봄 담당\" },\n                { label: \"전화\", icon: <PhoneIcon />, value: <a href=\"tel:064-710-0000\">064-710-0000</a> },\n                { label: \"운영 시간\", icon: <ClockIcon />, value: \"평일 09:00~18:00 (점심 12:00~13:00)\" },\n                { label: \"주소\", icon: <LocationIcon />, value: \"제주특별자치도 제주시 문연로 6\" },\n              ]}\n              actions={\n                <>\n                  <Button asChild>\n                    <a href=\"tel:064-710-0000\">\n                      <PhoneIcon />\n                      전화 걸기\n                    </a>\n                  </Button>\n                  <Button variant=\"outline\" asChild>\n                    <a href=\"https://map.kakao.com/link/search/제주특별자치도청\" target=\"_blank\" rel=\"noopener noreferrer\">\n                      지도에서 위치 보기\n                      <ExternalLinkIcon />\n                      <span className=\"sr-only\">(새 창)</span>\n                    </a>\n                  </Button>\n                </>\n              }\n            />\n          </div>\n          <RelatedLinks\n            links={[\n              { label: \"긴급돌봄 신청\", href: \"#\" },\n              { label: \"장기요양 등급 안내\", href: \"#\" },\n              { label: \"노인 일자리 찾기\", href: \"#\" },\n              { label: \"복지 상담 예약\", href: \"#\" },\n            ]}\n          />\n        </section>\n      </PublicMain>\n      <Identifier>제주특별자치도 공공서비스 UI 식별 예제</Identifier>\n      <PublicFooter>\n        <strong>제주 돌봄서비스</strong>\n        <p className=\"mt-2 mb-0\">본 페이지는 제주 디자인 시스템의 대민 UI 표준 예제이며 실제 서비스 화면이 아닙니다.</p>\n      </PublicFooter>\n    </div>\n  )\n}\n\n"
    }
  ]
}
